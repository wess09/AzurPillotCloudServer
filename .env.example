# ===== 基础 =====
# HTTP 监听地址
LISTEN_ADDR=:8080
# PostgreSQL 连接串（libpq 格式）
DATABASE_URL=postgres://apcloud:apcloud@localhost:5432/apcloud?sslmode=disable
# 管理接口 Bearer Token；留空则管理接口整体关闭
ADMIN_TOKEN=change-me
# B recognition worker credential (separate from ADMIN_TOKEN).
STATISTICS_TOKEN=
RECOGNIZER_URL=
WORKER_TOKEN=
# Public node A endpoint. Both legacy and resumable uploads use 307 redirects;
# clients connect directly to A, so C does not need to reach this address.
LEGACY_UPLOAD_PUBLIC_URL=
MAX_FILE_BYTES=10485760
MAX_GROUP_BYTES=524288000
# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ===== 限流（按来源 IP，公开/管理/Worker 各自独立令牌桶） =====
# 每秒补充的请求数与瞬时突发请求数；不是同时执行请求的并发上限。
RATE_LIMIT_RPS=5000
RATE_LIMIT_BURST=8000

# ===== 区服网关查询与缓存 =====
GATEWAY_TIMEOUT=10s
CACHE_TTL=8s
CACHE_REFRESH_INTERVAL=5s

# 国服官方公告：启动时同步，此后每 10 分钟检查；失败保留上次结果。
MAINTENANCE_SYNC_ENABLED=true
MAINTENANCE_SYNC_INTERVAL=10m
MAINTENANCE_SYNC_TIMEOUT=12s

# ===== 请求与停机 =====
REQUEST_TIMEOUT=15s
SHUTDOWN_GRACE=30s

# ===== CL1 =====
# 请求去重结果保留时长（计划规定 24 小时）
DEDUP_TTL=24h

# ===== 静态发布 =====
PUBLISH_DIR=public
PUBLISH_TIMEOUT=90s

# ===== Cloudflare 发布（可选；留空时静态文件只生成到 PUBLISH_DIR） =====
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_NOTICE_WORKER=ap-notice
CF_UPDATE_WORKER=ap-update-policy
# 发布后的公网读取地址，用于发布确认
CF_NOTICE_PUBLIC_URL=https://api.azurpilot.com/api/v2/get/notice/data.json
CF_UPDATE_PUBLIC_URL=https://api.azurpilot.com/api/v2/get/update/data.json
CF_TIMEOUT=30s

# ===== v3 委托/科研统计 =====
# 关闭后 /api/v3/get/* 与 /api/v3/post/drops 返回 503。
V3_ENABLED=true
# 小时聚合任务间隔，最小 1m。
AGG_INTERVAL=1h
# 模板 manifest/delta/mappings 的上游地址（已发布的 Worker 自定义域名）。
TEMPLATE_PUBLIC_BASE=https://templates.azurpilot.com
# 模板读取缓存时长（1s–1h）。
TEMPLATE_PROXY_CACHE=60s
# 未知模板上传转发到模板服务器的地址；留空时 /api/v3/post/templates/unknown 返回 503。
TEMPLATE_INGEST_URL=
# 与模板服务器 TEMPLATE_INGEST_TOKEN 相同。
TEMPLATE_INGEST_TOKEN=
