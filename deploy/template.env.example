# 模板服务器环境变量示例。复制为 deploy/template.env 后填入真实值。
# 该文件包含凭据，不要提交到 Git。

TEMPLATE_DB_NAME=templates
TEMPLATE_DB_USER=templates
TEMPLATE_DB_PASSWORD=change-me

TEMPLATE_PORT=8090
TEMPLATE_LISTEN_ADDR=:8090

# 管理 API（模板 CRUD、映射、发布）的 Bearer Token。
TEMPLATE_ADMIN_TOKEN=change-me-admin
# 主 API 调用未知模板上传接口的 Bearer Token，需与主 API 的 TEMPLATE_INGEST_TOKEN 一致。
TEMPLATE_INGEST_TOKEN=change-me-ingest

# Ed25519 签名私钥：base64 或 hex 的 32 字节 seed / 64 字节私钥。
# 生成示例：openssl rand -base64 32
# 留空时每次启动生成临时密钥（仅用于开发，客户端固定公钥会失效）。
TEMPLATE_SIGNING_KEY=

# 已发布 Worker 的自定义域名。不要使用 *.workers.dev（该网络下被阻断）。
TEMPLATE_PUBLIC_BASE=https://templates.azurpilot.com

# true 时每次 publish 都会 wrangler deploy；false 时只写 TEMPLATE_PUBLISH_DIR。
CF_DEPLOY=false
CF_WORKER_NAME=azurpilot-templates
CLOUDFLARE_ACCOUNT_ID=
# 需要 Workers Scripts Edit、Workers Routes Edit、DNS Edit、Zone Read。
CLOUDFLARE_API_TOKEN=

TEMPLATE_SELF_CHECK=true
TEMPLATE_SELF_CHECK_ATTEMPTS=20
TEMPLATE_SELF_CHECK_DELAY=5s
TEMPLATE_EXPIRES_DAYS=30
